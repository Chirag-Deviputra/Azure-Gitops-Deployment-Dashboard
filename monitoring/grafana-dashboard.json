{
  "title": "GitOps Deployment Dashboard",
  "tags": [
    "gitops",
    "aks"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "panels": [
    {
      "type": "timeseries",
      "title": "Request rate",
      "targets": [
        {
          "expr": "sum(rate(gitops_http_requests_total{namespace=\"gitops-dev\",service=\"gitops-dashboard-backend\"}[5m]))",
          "legendFormat": "requests/sec"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "timeseries",
      "title": "P95 latency",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(gitops_http_request_duration_seconds_bucket{namespace=\"gitops-dev\",service=\"gitops-dashboard-backend\"}[5m])))",
          "legendFormat": "p95"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      }
    }
  ]
}
